# Django
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon Postgres in production, local Postgres in dev)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://reloop_user:reloop_pass@localhost:5432/reloop

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MTN Mobile Money (Collections). Get a subscription key at
# https://momodeveloper.mtn.com (Products > Collections), then run
#   python manage.py momo_sandbox_setup
# to create MOMO_API_USER and MOMO_API_KEY. Leave empty to disable MoMo.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Optional: public URL MTN calls when a payment finishes, e.g.
# https://your-backend.example.com/api/payments/momo/callback/
MOMO_CALLBACK_URL=

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7
